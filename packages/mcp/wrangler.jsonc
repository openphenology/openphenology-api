// The hosted MCP server. Only staging is set up; production needs approval
// (#44). The MCP (staging) workflow deploys it; by hand, from this folder:
//   pnpm dlx wrangler@4.148.0 deploy --env staging
{
  "name": "openphenology-worker-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "staging": {
      "name": "openphenology-staging-worker-mcp",
      "routes": [
        {
          "pattern": "api-staging.openphenology.com/mcp*",
          "zone_name": "openphenology.com",
        },
      ],
      // Where openphenology/data publishes the staging release files.
      "vars": { "API_BASE_URL": "https://api-staging.openphenology.com/" },
      // 60 requests a minute from each address.
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "4401",
          "simple": { "limit": 60, "period": 60 },
        },
      ],
      // Caps the cost of each request.
      "limits": { "cpu_ms": 50 },
      // Nothing is logged, so no ZIP code or question is kept.
      "observability": { "enabled": false },
    },
  },
}
