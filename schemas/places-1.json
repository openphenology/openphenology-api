{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenPhenology places/1",
  "description": "Every watershed, every ecoregion, or every national and state park and metro park system with results, with its species with a result (ODR-2026-043, ODR-2026-044). No place file holds a sensitive species. May be split into shards.",
  "type": "object",
  "required": [
    "id",
    "kind",
    "format",
    "provenance",
    "data"
  ],
  "properties": {
    "id": {
      "description": "The file's path from the API root.",
      "type": "string",
      "pattern": "^releases/\\d{4}-\\d{2}-\\d{2}/places/(watersheds|ecoregions|parks)(/\\d+)?\\.json$"
    },
    "kind": {
      "description": "The format's name, such as `county-weekly`.",
      "const": "places"
    },
    "format": {
      "description": "Format name and version, for example `county-weekly/1.0`.",
      "type": "string",
      "pattern": "^places/1\\.\\d+$"
    },
    "provenance": {
      "description": "Where the content came from.",
      "type": "object",
      "required": [
        "release",
        "sources",
        "licences",
        "gbif_download_dois",
        "method",
        "taxonomy",
        "boundaries",
        "ranges",
        "protection",
        "code",
        "run"
      ],
      "properties": {
        "release": {
          "description": "The release the file belongs to, such as `2026-10-19`.",
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "sources": {
          "description": "Source IDs, as listed in `sources.json`.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "licences": {
          "description": "The licences of those sources.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gbif_download_dois": {
          "description": "The GBIF downloads the records came from, as DOIs.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "method": {
          "description": "The method version, such as `seasonal-3`.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "taxonomy": {
          "description": "The taxonomy version species keys come from.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "boundaries": {
          "description": "The boundary version areas come from.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ranges": {
          "description": "Each mapped range edition used.",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "protection": {
          "description": "The version of each sensitive-species list applied, by list.",
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "description": "The commit of the code that produced the file.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "run": {
          "description": "The run that produced the file.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "data": {
      "description": "The content, as the format sets out.",
      "type": "object",
      "required": [
        "kind",
        "places"
      ],
      "properties": {
        "kind": {
          "description": "`watersheds`, `ecoregions` or `parks`.",
          "enum": [
            "watersheds",
            "ecoregions",
            "parks"
          ]
        },
        "places": {
          "description": "Every place of that kind.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "area",
              "level",
              "name",
              "slug",
              "code",
              "states",
              "continues_into",
              "counties",
              "species_keys",
              "effort",
              "best_weeks",
              "park"
            ],
            "properties": {
              "area": {
                "description": "The place's area code, such as `huc8-04100011`.",
                "type": "string",
                "pattern": "^(huc8-\\d{8}|eco-\\d+|parks?-[a-z0-9]+(-[a-z0-9]+)*)$"
              },
              "level": {
                "description": "What kind of place it is.",
                "enum": [
                  "watershed",
                  "ecoregion",
                  "park",
                  "park-system"
                ]
              },
              "name": {
                "description": "Its name.",
                "type": "string",
                "minLength": 1
              },
              "slug": {
                "description": "Its address slug.",
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "code": {
                "description": "A watershed's HUC8 code, as a string such as `04100011`, or an\necoregion's RESOLVE `ECO_ID`, as a number; `null` for a park or metro\npark system.",
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d{8}$"
                  },
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "states": {
                "description": "The covered states it lies in.",
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z]{2}-[a-z0-9]{1,3}$"
                }
              },
              "continues_into": {
                "description": "The states it lies in that are not covered yet, possibly none. Its\nresults come from its covered part only.",
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z]{2}-[a-z0-9]{1,3}$"
                }
              },
              "counties": {
                "description": "The county codes it touches.",
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^\\d{5}$"
                }
              },
              "species_keys": {
                "description": "Species with a result there. Empty for a park or metro park system below\nthe minimum of 5 species, which has no other place file.",
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._-]+$"
                }
              },
              "effort": {
                "description": "Records of all species counted in the place, weeks 1 to 53.",
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 53,
                "maxItems": 53
              },
              "best_weeks": {
                "description": "For a park or metro park system with results, the weeks in which the\nmost species are recorded there (data rules `seasonal.md`, Best weeks to\nvisit a park); `null` otherwise, and always for a watershed or ecoregion.",
                "anyOf": [
                  {
                    "type": "object",
                    "required": [
                      "all",
                      "groups"
                    ],
                    "properties": {
                      "all": {
                        "description": "The span over all species with a result there.",
                        "type": "array",
                        "prefixItems": [
                          {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 53
                          },
                          {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 53
                          }
                        ],
                        "items": false,
                        "minItems": 2
                      },
                      "groups": {
                        "description": "The span per `group`; groups with no span are left out.",
                        "type": "object",
                        "propertyNames": {
                          "type": "string",
                          "pattern": "^[a-z]+(-[a-z]+)*$"
                        },
                        "additionalProperties": {
                          "type": "array",
                          "prefixItems": [
                            {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 53
                            },
                            {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 53
                            }
                          ],
                          "items": false,
                          "minItems": 2
                        }
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "park": {
                "description": "A park's or metro park system's details; `null` for a watershed or ecoregion.",
                "anyOf": [
                  {
                    "type": "object",
                    "required": [
                      "type",
                      "agency",
                      "acres",
                      "official_url",
                      "has_page",
                      "parks"
                    ],
                    "properties": {
                      "type": {
                        "description": "`national` or `state` for a park, `park-system` for a metro park system.",
                        "enum": [
                          "national",
                          "state",
                          "park-system"
                        ]
                      },
                      "agency": {
                        "description": "The managing agency.",
                        "type": "string",
                        "minLength": 1
                      },
                      "acres": {
                        "description": "Its area in acres; `null` for a metro park system.",
                        "anyOf": [
                          {
                            "type": "number",
                            "minimum": 0
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "official_url": {
                        "description": "Its page on its managing agency's official site, or `null` when it has none.",
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "has_page": {
                        "description": "True when at least 5 species have a result there, so it has a page.",
                        "type": "boolean"
                      },
                      "parks": {
                        "description": "A metro park system's park names; empty for a park.",
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "allOf": [
              {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "level": {
                        "const": "state"
                      },
                      "area": {
                        "type": "string",
                        "pattern": "^[a-z]{2}-[a-z0-9]{1,3}$"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "level": {
                        "const": "county"
                      },
                      "area": {
                        "type": "string",
                        "pattern": "^\\d{5}$"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "level": {
                        "const": "watershed"
                      },
                      "area": {
                        "type": "string",
                        "pattern": "^huc8-\\d{8}$"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "level": {
                        "const": "ecoregion"
                      },
                      "area": {
                        "type": "string",
                        "pattern": "^eco-\\d+$"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "level": {
                        "const": "park"
                      },
                      "area": {
                        "type": "string",
                        "pattern": "^park-[a-z0-9]+(-[a-z0-9]+)*$"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "level": {
                        "const": "park-system"
                      },
                      "area": {
                        "type": "string",
                        "pattern": "^parks-[a-z0-9]+(-[a-z0-9]+)*$"
                      }
                    }
                  }
                ]
              },
              {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "level": {
                        "const": "watershed"
                      },
                      "code": {
                        "type": "string",
                        "pattern": "^\\d{8}$"
                      },
                      "best_weeks": {
                        "type": "null"
                      },
                      "park": {
                        "type": "null"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "level": {
                        "const": "ecoregion"
                      },
                      "code": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "best_weeks": {
                        "type": "null"
                      },
                      "park": {
                        "type": "null"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "level": {
                        "const": "park"
                      },
                      "code": {
                        "type": "null"
                      },
                      "park": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "enum": [
                              "national",
                              "state"
                            ]
                          },
                          "acres": {
                            "type": "number"
                          },
                          "parks": {
                            "type": "array",
                            "maxItems": 0
                          }
                        }
                      }
                    }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "level": {
                        "const": "park-system"
                      },
                      "code": {
                        "type": "null"
                      },
                      "park": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "const": "park-system"
                          },
                          "acres": {
                            "type": "null"
                          }
                        }
                      }
                    }
                  }
                ]
              },
              {
                "if": {
                  "type": "object",
                  "required": [
                    "park"
                  ],
                  "properties": {
                    "park": {
                      "type": "object",
                      "required": [
                        "has_page"
                      ],
                      "properties": {
                        "has_page": {
                          "const": true
                        }
                      }
                    }
                  }
                },
                "then": {
                  "type": "object",
                  "properties": {
                    "species_keys": {
                      "type": "array",
                      "minItems": 5
                    }
                  }
                }
              },
              {
                "if": {
                  "type": "object",
                  "required": [
                    "park"
                  ],
                  "properties": {
                    "park": {
                      "type": "object",
                      "required": [
                        "has_page"
                      ],
                      "properties": {
                        "has_page": {
                          "const": false
                        }
                      }
                    }
                  }
                },
                "then": {
                  "type": "object",
                  "properties": {
                    "species_keys": {
                      "type": "array",
                      "maxItems": 0
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "type": "object",
      "properties": {
        "data": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "watersheds"
                },
                "places": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "level": {
                        "enum": [
                          "watershed"
                        ]
                      }
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "ecoregions"
                },
                "places": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "level": {
                        "enum": [
                          "ecoregion"
                        ]
                      }
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "parks"
                },
                "places": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "level": {
                        "enum": [
                          "park",
                          "park-system"
                        ]
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    }
  ]
}
