{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenPhenology place-weekly/1",
  "description": "A species' weekly result for a watershed, ecoregion, park or metro park system.",
  "type": "object",
  "required": [
    "id",
    "kind",
    "format",
    "provenance",
    "data"
  ],
  "properties": {
    "id": {
      "description": "The file's path from the API root.",
      "type": "string",
      "pattern": "^releases/\\d{4}-\\d{2}-\\d{2}/results/places/(huc8-\\d{8}|eco-\\d+|parks?-[a-z0-9]+(-[a-z0-9]+)*)/[A-Za-z0-9._-]+(/\\d+)?\\.json$"
    },
    "kind": {
      "description": "The format's name, such as `county-weekly`.",
      "const": "place-weekly"
    },
    "format": {
      "description": "Format name and version, for example `county-weekly/1.0`.",
      "type": "string",
      "pattern": "^place-weekly/1\\.\\d+$"
    },
    "provenance": {
      "description": "Where the content came from.",
      "type": "object",
      "required": [
        "release",
        "sources",
        "licences",
        "gbif_download_dois",
        "method",
        "taxonomy",
        "boundaries",
        "ranges",
        "protection",
        "code",
        "run"
      ],
      "properties": {
        "release": {
          "description": "The release the file belongs to, such as `2026-10-19`.",
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "sources": {
          "description": "Source IDs, as listed in `sources.json`.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "licences": {
          "description": "The licences of those sources.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gbif_download_dois": {
          "description": "The GBIF downloads the records came from, as DOIs.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "method": {
          "description": "The method version, such as `seasonal-3`.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "taxonomy": {
          "description": "The taxonomy version species keys come from.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "boundaries": {
          "description": "The boundary version areas come from.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ranges": {
          "description": "Each mapped range edition used.",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "protection": {
          "description": "The version of each sensitive-species list applied, by list.",
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "description": "The commit of the code that produced the file.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "run": {
          "description": "The run that produced the file.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "data": {
      "description": "The content, as the format sets out.",
      "type": "object",
      "required": [
        "area",
        "species_key",
        "included_records",
        "contributing_years",
        "thresholds",
        "weekly",
        "season",
        "season_withheld",
        "effort",
        "limits"
      ],
      "properties": {
        "area": {
          "description": "The area code.",
          "type": "string",
          "pattern": "^(huc8-\\d{8}|eco-\\d+|parks?-[a-z0-9]+(-[a-z0-9]+)*)$"
        },
        "species_key": {
          "description": "The species key.",
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "included_records": {
          "description": "Records counted, over all weeks.",
          "type": "integer",
          "minimum": 0
        },
        "contributing_years": {
          "description": "Calendar years with at least one counted record.",
          "type": "integer",
          "minimum": 0
        },
        "thresholds": {
          "description": "The minimum records and years the method requires.",
          "type": "object",
          "required": [
            "records",
            "years"
          ],
          "properties": {
            "records": {
              "description": "Minimum records.",
              "type": "integer",
              "minimum": 0
            },
            "years": {
              "description": "Minimum years.",
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "weekly": {
          "description": "Records counted and years contributing, each for weeks 1 to 53.",
          "type": "object",
          "required": [
            "records",
            "years"
          ],
          "properties": {
            "records": {
              "description": "Records counted, weeks 1 to 53.",
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "minItems": 53,
              "maxItems": 53
            },
            "years": {
              "description": "Years contributing, weeks 1 to 53.",
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "minItems": 53,
              "maxItems": 53
            }
          }
        },
        "season": {
          "description": "Early, middle and late weeks, or empty when withheld.",
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 53
          },
          "maxItems": 3
        },
        "season_withheld": {
          "description": "Why `season` is empty, or `null`.",
          "anyOf": [
            {
              "enum": [
                "year-round",
                "two-seasons",
                "one-year",
                "precision"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "effort": {
          "description": "Records of all species counted in the area, weeks 1 to 53.",
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 53,
          "maxItems": 53
        },
        "limits": {
          "description": "What the result does not show.",
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "season": {
                  "type": "array",
                  "minItems": 3
                },
                "season_withheld": {
                  "type": "null"
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "season": {
                  "type": "array",
                  "maxItems": 0
                },
                "season_withheld": {
                  "enum": [
                    "year-round",
                    "two-seasons",
                    "one-year",
                    "precision"
                  ]
                }
              }
            }
          ]
        }
      ]
    }
  }
}
