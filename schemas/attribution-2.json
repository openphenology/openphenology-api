{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenPhenology attribution/2",
  "description": "The sources behind a result.",
  "type": "object",
  "required": [
    "id",
    "kind",
    "format",
    "provenance",
    "data"
  ],
  "properties": {
    "id": {
      "description": "The file's path from the API root.",
      "type": "string",
      "pattern": "^releases/\\d{4}-\\d{2}-\\d{2}/attribution/([a-z]{2}-[a-z0-9]{1,3}(/\\d{5})?|places/(huc8-\\d{8}|eco-\\d+|parks?-[a-z0-9]+(-[a-z0-9]+)*))/[A-Za-z0-9._-]+(/\\d+)?\\.json$"
    },
    "kind": {
      "description": "The format's name, such as `county-weekly`.",
      "const": "attribution"
    },
    "format": {
      "description": "Format name and version, for example `county-weekly/1.0`.",
      "type": "string",
      "pattern": "^attribution/2\\.\\d+$"
    },
    "provenance": {
      "description": "Where the content came from.",
      "type": "object",
      "required": [
        "release",
        "sources",
        "licences",
        "gbif_download_dois",
        "method",
        "taxonomy",
        "boundaries",
        "ranges",
        "protection",
        "code",
        "run"
      ],
      "properties": {
        "release": {
          "description": "The release the file belongs to, such as `2026-10-19`.",
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "sources": {
          "description": "Source IDs, as listed in `sources.json`.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "licences": {
          "description": "The licences of those sources.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gbif_download_dois": {
          "description": "The GBIF downloads the records came from, as DOIs.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "method": {
          "description": "The method version, such as `seasonal-3`.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "taxonomy": {
          "description": "The taxonomy version species keys come from.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "boundaries": {
          "description": "The boundary version areas come from.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ranges": {
          "description": "Each mapped range edition used.",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "protection": {
          "description": "The version of each sensitive-species list applied, by list.",
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "description": "The commit of the code that produced the file.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "run": {
          "description": "The run that produced the file.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "data": {
      "description": "The content, as the format sets out.",
      "type": "object",
      "required": [
        "area",
        "species_key",
        "datasets",
        "gbif_download_dois",
        "records"
      ],
      "properties": {
        "area": {
          "description": "The area code.",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z]{2}-[a-z0-9]{1,3}$"
            },
            {
              "type": "string",
              "pattern": "^\\d{5}$"
            },
            {
              "type": "string",
              "pattern": "^(huc8-\\d{8}|eco-\\d+|parks?-[a-z0-9]+(-[a-z0-9]+)*)$"
            }
          ]
        },
        "species_key": {
          "description": "The species key.",
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "datasets": {
          "description": "Each dataset the records came from.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "dataset_key",
              "title",
              "publisher",
              "citation",
              "url",
              "records"
            ],
            "properties": {
              "dataset_key": {
                "description": "The dataset's key.",
                "type": "string",
                "minLength": 1
              },
              "title": {
                "description": "Its title.",
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "publisher": {
                "description": "Its publisher.",
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "citation": {
                "description": "How to cite it.",
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "url": {
                "description": "Its page.",
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "records": {
                "description": "Records it contributed.",
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "gbif_download_dois": {
          "description": "The GBIF downloads the records came from, as DOIs.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "records": {
          "description": "`attribution/2.0`: the records behind the result, one entry per kind\nof link; `null` for a sensitive species (ODR-2026-052). Use\n`recordLinks()` for full links.",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "link",
                  "ids"
                ],
                "properties": {
                  "link": {
                    "description": "The record page's address, with `{id}` in place of the record's number.",
                    "type": "string",
                    "pattern": "^https://[^\\s]*\\{id\\}[^\\s]*$"
                  },
                  "ids": {
                    "description": "The records' numbers in ascending order: the first as itself, each later\none as its difference from the one before.",
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "minItems": 1
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
