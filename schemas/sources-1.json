{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenPhenology sources/1",
  "description": "Each source, its licence and how to credit it.",
  "type": "object",
  "required": [
    "id",
    "kind",
    "format",
    "provenance",
    "data"
  ],
  "properties": {
    "id": {
      "description": "The file's path from the API root.",
      "type": "string",
      "pattern": "^releases/\\d{4}-\\d{2}-\\d{2}/sources(/\\d+)?\\.json$"
    },
    "kind": {
      "description": "The format's name, such as `county-weekly`.",
      "const": "sources"
    },
    "format": {
      "description": "Format name and version, for example `county-weekly/1.0`.",
      "type": "string",
      "pattern": "^sources/1\\.\\d+$"
    },
    "provenance": {
      "description": "Where the content came from.",
      "type": "object",
      "required": [
        "release",
        "sources",
        "licences",
        "gbif_download_dois",
        "method",
        "taxonomy",
        "boundaries",
        "ranges",
        "protection",
        "code",
        "run"
      ],
      "properties": {
        "release": {
          "description": "The release the file belongs to, such as `2026-10-19`.",
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "sources": {
          "description": "Source IDs, as listed in `sources.json`.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "licences": {
          "description": "The licences of those sources.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gbif_download_dois": {
          "description": "The GBIF downloads the records came from, as DOIs.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "method": {
          "description": "The method version, such as `seasonal-3`.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "taxonomy": {
          "description": "The taxonomy version species keys come from.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "boundaries": {
          "description": "The boundary version areas come from.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ranges": {
          "description": "Each mapped range edition used.",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "protection": {
          "description": "The version of each sensitive-species list applied, by list.",
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "description": "The commit of the code that produced the file.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "run": {
          "description": "The run that produced the file.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "data": {
      "description": "The content, as the format sets out.",
      "type": "object",
      "required": [
        "sources"
      ],
      "properties": {
        "sources": {
          "description": "Each source.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source",
              "name",
              "kind",
              "licence",
              "licence_url",
              "use",
              "reviewed",
              "credit",
              "url"
            ],
            "properties": {
              "source": {
                "description": "The source ID.",
                "type": "string",
                "minLength": 1
              },
              "name": {
                "description": "Its name.",
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "description": "What kind of source it is.",
                "type": "string",
                "minLength": 1
              },
              "licence": {
                "description": "Its licence.",
                "type": "string",
                "minLength": 1
              },
              "licence_url": {
                "description": "Where its licence is published.",
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "use": {
                "description": "What OpenPhenology uses it for.",
                "type": "string",
                "minLength": 1
              },
              "reviewed": {
                "description": "When its use was last reviewed, `YYYY-MM-DD`.",
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "credit": {
                "description": "How to credit it.",
                "type": "string",
                "minLength": 1
              },
              "url": {
                "description": "Its home page.",
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
