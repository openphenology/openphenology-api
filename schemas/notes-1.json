{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenPhenology notes/1",
  "description": "What changed since the previous release.",
  "type": "object",
  "required": [
    "id",
    "kind",
    "format",
    "provenance",
    "data"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^releases/\\d{4}-\\d{2}-\\d{2}/notes(/\\d+)?\\.json$"
    },
    "kind": {
      "const": "notes"
    },
    "format": {
      "type": "string",
      "pattern": "^notes/1\\.\\d+$"
    },
    "provenance": {
      "type": "object",
      "required": [
        "release",
        "sources",
        "licences",
        "gbif_download_dois",
        "method",
        "taxonomy",
        "boundaries",
        "ranges",
        "protection",
        "code",
        "run"
      ],
      "properties": {
        "release": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "licences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gbif_download_dois": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "taxonomy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "boundaries": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ranges": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "protection": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "run": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "data": {
      "type": "object",
      "required": [
        "release",
        "previous",
        "results",
        "key_changes",
        "corrections",
        "formats"
      ],
      "properties": {
        "release": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "previous": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "results": {
          "type": "object",
          "required": [
            "added",
            "changed",
            "removed"
          ],
          "properties": {
            "added": {
              "type": "integer",
              "minimum": 0
            },
            "changed": {
              "type": "integer",
              "minimum": 0
            },
            "removed": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "key_changes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "old",
              "new"
            ],
            "properties": {
              "old": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+$"
              },
              "new": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+$"
              }
            }
          }
        },
        "corrections": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "formats": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "format",
              "change",
              "until"
            ],
            "properties": {
              "format": {
                "type": "string",
                "minLength": 1
              },
              "change": {
                "type": "string",
                "minLength": 1
              },
              "until": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}
