{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenPhenology notes/1",
  "description": "What changed since the previous release.",
  "type": "object",
  "required": [
    "id",
    "kind",
    "format",
    "provenance",
    "data"
  ],
  "properties": {
    "id": {
      "description": "The file's path from the API root.",
      "type": "string",
      "pattern": "^releases/\\d{4}-\\d{2}-\\d{2}/notes(/\\d+)?\\.json$"
    },
    "kind": {
      "description": "The format's name, such as `county-weekly`.",
      "const": "notes"
    },
    "format": {
      "description": "Format name and version, for example `county-weekly/1.0`.",
      "type": "string",
      "pattern": "^notes/1\\.\\d+$"
    },
    "provenance": {
      "description": "Where the content came from.",
      "type": "object",
      "required": [
        "release",
        "sources",
        "licences",
        "gbif_download_dois",
        "method",
        "taxonomy",
        "boundaries",
        "ranges",
        "protection",
        "code",
        "run"
      ],
      "properties": {
        "release": {
          "description": "The release the file belongs to, such as `2026-10-19`.",
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "sources": {
          "description": "Source IDs, as listed in `sources.json`.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "licences": {
          "description": "The licences of those sources.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gbif_download_dois": {
          "description": "The GBIF downloads the records came from, as DOIs.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "method": {
          "description": "The method version, such as `seasonal-3`.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "taxonomy": {
          "description": "The taxonomy version species keys come from.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "boundaries": {
          "description": "The boundary version areas come from.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ranges": {
          "description": "Each mapped range edition used.",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "protection": {
          "description": "The version of each sensitive-species list applied, by list.",
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "description": "The commit of the code that produced the file.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "run": {
          "description": "The run that produced the file.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "data": {
      "description": "The content, as the format sets out.",
      "type": "object",
      "required": [
        "release",
        "previous",
        "results",
        "key_changes",
        "corrections",
        "formats"
      ],
      "properties": {
        "release": {
          "description": "The release ID.",
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "previous": {
          "description": "The previous release, or `null` for the first one.",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "results": {
          "description": "How many results were added, changed and removed.",
          "type": "object",
          "required": [
            "added",
            "changed",
            "removed"
          ],
          "properties": {
            "added": {
              "description": "Results added.",
              "type": "integer",
              "minimum": 0
            },
            "changed": {
              "description": "Results changed.",
              "type": "integer",
              "minimum": 0
            },
            "removed": {
              "description": "Results removed.",
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "key_changes": {
          "description": "Species keys that changed with the taxonomy.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "old",
              "new"
            ],
            "properties": {
              "old": {
                "description": "The key before.",
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+$"
              },
              "new": {
                "description": "The key now.",
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+$"
              }
            }
          }
        },
        "corrections": {
          "description": "Corrections, as short texts.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "formats": {
          "description": "Format changes, including a major version carried alongside the old one.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "format",
              "change",
              "until"
            ],
            "properties": {
              "format": {
                "description": "The format and version.",
                "type": "string",
                "minLength": 1
              },
              "change": {
                "description": "What changed.",
                "type": "string",
                "minLength": 1
              },
              "until": {
                "description": "When the old version stops, or `null`.",
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}
