{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenPhenology place-boundaries/1",
  "description": "Watershed and ecoregion outlines, and park middles as points, for maps, as a GeoJSON FeatureCollection. For display only.",
  "type": "object",
  "required": [
    "id",
    "kind",
    "format",
    "provenance",
    "data"
  ],
  "properties": {
    "id": {
      "description": "The file's path from the API root.",
      "type": "string",
      "pattern": "^releases/\\d{4}-\\d{2}-\\d{2}/places/(watersheds|ecoregions|parks)/boundaries(/\\d+)?\\.json$"
    },
    "kind": {
      "description": "The format's name, such as `county-weekly`.",
      "const": "place-boundaries"
    },
    "format": {
      "description": "Format name and version, for example `county-weekly/1.0`.",
      "type": "string",
      "pattern": "^place-boundaries/1\\.\\d+$"
    },
    "provenance": {
      "description": "Where the content came from.",
      "type": "object",
      "required": [
        "release",
        "sources",
        "licences",
        "gbif_download_dois",
        "method",
        "taxonomy",
        "boundaries",
        "ranges",
        "protection",
        "code",
        "run"
      ],
      "properties": {
        "release": {
          "description": "The release the file belongs to, such as `2026-10-19`.",
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "sources": {
          "description": "Source IDs, as listed in `sources.json`.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "licences": {
          "description": "The licences of those sources.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gbif_download_dois": {
          "description": "The GBIF downloads the records came from, as DOIs.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "method": {
          "description": "The method version, such as `seasonal-3`.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "taxonomy": {
          "description": "The taxonomy version species keys come from.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "boundaries": {
          "description": "The boundary version areas come from.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ranges": {
          "description": "Each mapped range edition used.",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "protection": {
          "description": "The version of each sensitive-species list applied, by list.",
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "description": "The commit of the code that produced the file.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "run": {
          "description": "The run that produced the file.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "data": {
      "description": "The content, as the format sets out.",
      "type": "object",
      "required": [
        "type",
        "features"
      ],
      "properties": {
        "type": {
          "description": "Always `FeatureCollection`.",
          "const": "FeatureCollection"
        },
        "features": {
          "description": "One feature per place, or per park of a metro park system.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "properties",
              "geometry"
            ],
            "properties": {
              "type": {
                "description": "Always `Feature`.",
                "const": "Feature"
              },
              "properties": {
                "description": "The place.",
                "type": "object",
                "required": [
                  "area",
                  "name",
                  "slug",
                  "system"
                ],
                "properties": {
                  "area": {
                    "description": "The place's area code.",
                    "type": "string",
                    "pattern": "^(huc8-\\d{8}|eco-\\d+|parks?-[a-z0-9]+(-[a-z0-9]+)*)$"
                  },
                  "name": {
                    "description": "Its name.",
                    "type": "string",
                    "minLength": 1
                  },
                  "slug": {
                    "description": "Its address slug.",
                    "type": "string",
                    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                  },
                  "system": {
                    "description": "For a park in a metro park system, the system's area code; otherwise `null`.",
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^parks-[a-z0-9]+(-[a-z0-9]+)*$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              "geometry": {
                "description": "Its outline or middle, WGS 84 longitude and latitude.",
                "anyOf": [
                  {
                    "type": "object",
                    "required": [
                      "type",
                      "coordinates"
                    ],
                    "properties": {
                      "type": {
                        "description": "`MultiPolygon` for a watershed's or ecoregion's outline, `Point` for a park's middle.",
                        "const": "MultiPolygon"
                      },
                      "coordinates": {
                        "description": "For a `MultiPolygon`, polygons of rings of `[longitude, latitude]`\npositions; for a `Point`, one `[longitude, latitude]` position.",
                        "type": "array",
                        "items": {
                          "type": "array",
                          "items": {
                            "type": "array",
                            "items": {
                              "type": "array",
                              "prefixItems": [
                                {
                                  "type": "number",
                                  "minimum": -180,
                                  "maximum": 180
                                },
                                {
                                  "type": "number",
                                  "minimum": -90,
                                  "maximum": 90
                                }
                              ],
                              "items": false,
                              "minItems": 2
                            },
                            "minItems": 4
                          },
                          "minItems": 1
                        },
                        "minItems": 1
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "type",
                      "coordinates"
                    ],
                    "properties": {
                      "type": {
                        "description": "`MultiPolygon` for a watershed's or ecoregion's outline, `Point` for a park's middle.",
                        "const": "Point"
                      },
                      "coordinates": {
                        "description": "For a `MultiPolygon`, polygons of rings of `[longitude, latitude]`\npositions; for a `Point`, one `[longitude, latitude]` position.",
                        "type": "array",
                        "prefixItems": [
                          {
                            "type": "number",
                            "minimum": -180,
                            "maximum": 180
                          },
                          {
                            "type": "number",
                            "minimum": -90,
                            "maximum": 90
                          }
                        ],
                        "items": false,
                        "minItems": 2
                      }
                    }
                  }
                ]
              }
            },
            "allOf": [
              {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "properties": {
                        "type": "object",
                        "properties": {
                          "area": {
                            "anyOf": [
                              {
                                "type": "string",
                                "pattern": "^huc8-\\d{8}$"
                              },
                              {
                                "type": "string",
                                "pattern": "^eco-\\d+$"
                              }
                            ]
                          },
                          "system": {
                            "type": "null"
                          }
                        }
                      },
                      "geometry": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "const": "MultiPolygon"
                          }
                        }
                      }
                    }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "properties": {
                        "type": "object",
                        "properties": {
                          "area": {
                            "anyOf": [
                              {
                                "type": "string",
                                "pattern": "^park-[a-z0-9]+(-[a-z0-9]+)*$"
                              },
                              {
                                "type": "string",
                                "pattern": "^parks-[a-z0-9]+(-[a-z0-9]+)*$"
                              }
                            ]
                          }
                        }
                      },
                      "geometry": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "const": "Point"
                          }
                        }
                      }
                    }
                  }
                ]
              }
            ]
          }
        }
      }
    }
  }
}
