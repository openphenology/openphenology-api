{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenPhenology methods/1",
  "description": "How results are made: the method and its numbers.",
  "type": "object",
  "required": [
    "id",
    "kind",
    "format",
    "provenance",
    "data"
  ],
  "properties": {
    "id": {
      "description": "The file's path from the API root.",
      "type": "string",
      "pattern": "^releases/\\d{4}-\\d{2}-\\d{2}/methods(/\\d+)?\\.json$"
    },
    "kind": {
      "description": "The format's name, such as `county-weekly`.",
      "const": "methods"
    },
    "format": {
      "description": "Format name and version, for example `county-weekly/1.0`.",
      "type": "string",
      "pattern": "^methods/1\\.\\d+$"
    },
    "provenance": {
      "description": "Where the content came from.",
      "type": "object",
      "required": [
        "release",
        "sources",
        "licences",
        "gbif_download_dois",
        "method",
        "taxonomy",
        "boundaries",
        "ranges",
        "protection",
        "code",
        "run"
      ],
      "properties": {
        "release": {
          "description": "The release the file belongs to, such as `2026-10-19`.",
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "sources": {
          "description": "Source IDs, as listed in `sources.json`.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "licences": {
          "description": "The licences of those sources.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gbif_download_dois": {
          "description": "The GBIF downloads the records came from, as DOIs.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "method": {
          "description": "The method version, such as `seasonal-3`.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "taxonomy": {
          "description": "The taxonomy version species keys come from.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "boundaries": {
          "description": "The boundary version areas come from.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ranges": {
          "description": "Each mapped range edition used.",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "protection": {
          "description": "The version of each sensitive-species list applied, by list.",
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "description": "The commit of the code that produced the file.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "run": {
          "description": "The run that produced the file.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "data": {
      "description": "The content, as the format sets out.",
      "type": "object",
      "required": [
        "method",
        "data_rules",
        "thresholds",
        "weeks",
        "pooled_from",
        "taxonomy",
        "boundaries",
        "protection",
        "ranges",
        "limits"
      ],
      "properties": {
        "method": {
          "description": "The method version.",
          "type": "string",
          "minLength": 1
        },
        "data_rules": {
          "description": "The data rules version.",
          "type": "string",
          "minLength": 1
        },
        "thresholds": {
          "description": "Every number the method uses, by name.",
          "type": "object"
        },
        "weeks": {
          "description": "How weeks are counted.",
          "type": "string",
          "minLength": 1
        },
        "pooled_from": {
          "description": "The first date records are pooled from.",
          "type": "string",
          "minLength": 1
        },
        "taxonomy": {
          "description": "The taxonomy version.",
          "type": "string",
          "minLength": 1
        },
        "boundaries": {
          "description": "The boundary version.",
          "type": "string",
          "minLength": 1
        },
        "protection": {
          "description": "The version of each sensitive-species list, by list.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "ranges": {
          "description": "Each mapped range edition.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limits": {
          "description": "What results do not show.",
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
