{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenPhenology methods/1",
  "description": "How results are made: the method and its numbers.",
  "type": "object",
  "required": [
    "id",
    "kind",
    "format",
    "provenance",
    "data"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "methods"
    },
    "format": {
      "type": "string",
      "pattern": "^methods/1\\.\\d+$"
    },
    "provenance": {
      "type": "object",
      "required": [
        "release",
        "sources",
        "licences",
        "gbif_download_dois",
        "method",
        "taxonomy",
        "boundaries",
        "ranges",
        "protection",
        "code",
        "run"
      ],
      "properties": {
        "release": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "licences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gbif_download_dois": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "taxonomy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "boundaries": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ranges": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "protection": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "run": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "data": {
      "type": "object",
      "required": [
        "method",
        "data_rules",
        "thresholds",
        "weeks",
        "pooled_from",
        "taxonomy",
        "boundaries",
        "protection",
        "ranges",
        "limits"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "data_rules": {
          "type": "string",
          "minLength": 1
        },
        "thresholds": {
          "type": "object"
        },
        "weeks": {
          "type": "string",
          "minLength": 1
        },
        "pooled_from": {
          "type": "string",
          "minLength": 1
        },
        "taxonomy": {
          "type": "string",
          "minLength": 1
        },
        "boundaries": {
          "type": "string",
          "minLength": 1
        },
        "protection": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "ranges": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limits": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
