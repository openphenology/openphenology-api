{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenPhenology catalogue/1",
  "description": "Species with a result or a mapped range, by scientific name. May be split into shards.",
  "type": "object",
  "required": [
    "id",
    "kind",
    "format",
    "provenance",
    "data"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "catalogue"
    },
    "format": {
      "type": "string",
      "pattern": "^catalogue/1\\.\\d+$"
    },
    "provenance": {
      "type": "object",
      "required": [
        "release",
        "sources",
        "licences",
        "gbif_download_dois",
        "method",
        "taxonomy",
        "boundaries",
        "ranges",
        "protection",
        "code",
        "run"
      ],
      "properties": {
        "release": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "licences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gbif_download_dois": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "taxonomy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "boundaries": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ranges": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "protection": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "run": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "data": {
      "type": "object",
      "required": [
        "species"
      ],
      "properties": {
        "species": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "species_key",
              "scientific_name",
              "common_name",
              "rank",
              "kingdom",
              "phylum",
              "class",
              "order",
              "family",
              "genus",
              "group",
              "slug",
              "states"
            ],
            "properties": {
              "species_key": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+$"
              },
              "scientific_name": {
                "type": "string",
                "minLength": 1
              },
              "common_name": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "rank": {
                "type": "string",
                "minLength": 1
              },
              "kingdom": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "phylum": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "class": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "order": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "family": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "genus": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "group": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z]+(-[a-z]+)*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "slug": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "states": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z]{2}-[a-z0-9]{1,3}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
