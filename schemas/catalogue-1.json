{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenPhenology catalogue/1",
  "description": "Species with a result or a mapped range, by scientific name. May be split into shards.",
  "type": "object",
  "required": [
    "id",
    "kind",
    "format",
    "provenance",
    "data"
  ],
  "properties": {
    "id": {
      "description": "The file's path from the API root.",
      "type": "string",
      "pattern": "^releases/\\d{4}-\\d{2}-\\d{2}/catalogue(/\\d+)?\\.json$"
    },
    "kind": {
      "description": "The format's name, such as `county-weekly`.",
      "const": "catalogue"
    },
    "format": {
      "description": "Format name and version, for example `county-weekly/1.0`.",
      "type": "string",
      "pattern": "^catalogue/1\\.\\d+$"
    },
    "provenance": {
      "description": "Where the content came from.",
      "type": "object",
      "required": [
        "release",
        "sources",
        "licences",
        "gbif_download_dois",
        "method",
        "taxonomy",
        "boundaries",
        "ranges",
        "protection",
        "code",
        "run"
      ],
      "properties": {
        "release": {
          "description": "The release the file belongs to, such as `2026-10-19`.",
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "sources": {
          "description": "Source IDs, as listed in `sources.json`.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "licences": {
          "description": "The licences of those sources.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gbif_download_dois": {
          "description": "The GBIF downloads the records came from, as DOIs.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "method": {
          "description": "The method version, such as `seasonal-3`.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "taxonomy": {
          "description": "The taxonomy version species keys come from.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "boundaries": {
          "description": "The boundary version areas come from.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ranges": {
          "description": "Each mapped range edition used.",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "protection": {
          "description": "The version of each sensitive-species list applied, by list.",
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "description": "The commit of the code that produced the file.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "run": {
          "description": "The run that produced the file.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "data": {
      "description": "The content, as the format sets out.",
      "type": "object",
      "required": [
        "species"
      ],
      "properties": {
        "species": {
          "description": "The species, by scientific name.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "species_key",
              "scientific_name",
              "common_name",
              "rank",
              "kingdom",
              "phylum",
              "class",
              "order",
              "family",
              "genus",
              "group",
              "slug",
              "states"
            ],
            "properties": {
              "species_key": {
                "description": "The species key in the shared taxonomy.",
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+$"
              },
              "scientific_name": {
                "description": "The scientific name, without authorship.",
                "type": "string",
                "minLength": 1
              },
              "common_name": {
                "description": "The display name, or `null` when there is none.",
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "rank": {
                "description": "The taxonomic rank, such as `species`.",
                "type": "string",
                "minLength": 1
              },
              "kingdom": {
                "description": "The kingdom.",
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "phylum": {
                "description": "The phylum.",
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "class": {
                "description": "The class.",
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "order": {
                "description": "The order.",
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "family": {
                "description": "The family.",
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "genus": {
                "description": "The genus.",
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "group": {
                "description": "The browse group, such as `birds`.",
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z]+(-[a-z]+)*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "slug": {
                "description": "The page slug.",
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "states": {
                "description": "States with a result for this species.",
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z]{2}-[a-z0-9]{1,3}$"
                }
              },
              "photo": {
                "description": "The species' photo, exactly as its species file gives it, or `null`.\nAdded in `catalogue/1.2`, so absent from earlier files.",
                "anyOf": [
                  {
                    "type": "object",
                    "required": [
                      "id",
                      "source",
                      "sizes",
                      "credit",
                      "licence",
                      "licence_url",
                      "url"
                    ],
                    "properties": {
                      "id": {
                        "description": "`inat-` and the iNaturalist photo ID.",
                        "type": "string",
                        "pattern": "^inat-\\d+$"
                      },
                      "source": {
                        "description": "Where it was chosen from: the default photo, a taxon photo, or an observation photo.",
                        "enum": [
                          "default",
                          "taxon",
                          "observation"
                        ]
                      },
                      "sizes": {
                        "description": "Per role the photo was cut to, the widths made, smallest first.",
                        "type": "object",
                        "propertyNames": {
                          "enum": [
                            "hero",
                            "feature",
                            "species",
                            "card",
                            "thumb",
                            "social"
                          ]
                        },
                        "additionalProperties": {
                          "type": "array",
                          "items": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "minItems": 1
                        }
                      },
                      "credit": {
                        "description": "The credit iNaturalist gives, word for word; show it with the photo.",
                        "type": "string",
                        "minLength": 1
                      },
                      "licence": {
                        "description": "The licence's SPDX identifier, such as `CC-BY-NC-4.0`, or `CC0-1.0` or `PDM`.",
                        "type": "string",
                        "minLength": 1
                      },
                      "licence_url": {
                        "description": "The licence's address.",
                        "type": "string",
                        "minLength": 1
                      },
                      "url": {
                        "description": "The photo's page on iNaturalist.",
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sensitive_in": {
                "description": "The states in `states` where the species' records are sensitive because\nof the species itself (a government list or iNaturalist's location\nprotection). Describes the species, never a location. Added in\n`catalogue/1.3`, so absent from earlier files.",
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z]{2}-[a-z0-9]{1,3}$"
                }
              },
              "listed_in": {
                "description": "The states in `states` where one of the species' `statuses` listings\napplies: every state for a federal listing, its own state for a state\nlisting. Added in `catalogue/1.3`, so absent from earlier files.",
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z]{2}-[a-z0-9]{1,3}$"
                }
              },
              "introduced_in": {
                "description": "The states in `states` where one of the species' `introductions`\nlistings applies (the lower 48). Not being listed never means native.\nAdded in `catalogue/1.3`, so absent from earlier files.",
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z]{2}-[a-z0-9]{1,3}$"
                }
              },
              "seasons": {
                "description": "Each state in `states` with its season weeks, exactly as the species file\ngives them; empty when the species file has none or withholds them.\nAdded in `catalogue/1.1`, so absent from `catalogue/1.0` files.",
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z]{2}-[a-z0-9]{1,3}$"
                },
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 53
                  },
                  "maxItems": 3,
                  "anyOf": [
                    {
                      "type": "array",
                      "maxItems": 0
                    },
                    {
                      "type": "array",
                      "minItems": 3
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "format": {
            "enum": [
              "catalogue/1.0"
            ]
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "species": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "seasons": true
                  },
                  "required": [
                    "seasons"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "format": {
            "enum": [
              "catalogue/1.0",
              "catalogue/1.1"
            ]
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "species": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "photo": true
                  },
                  "required": [
                    "photo"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "format": {
            "enum": [
              "catalogue/1.0",
              "catalogue/1.1",
              "catalogue/1.2"
            ]
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "species": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "sensitive_in": true,
                    "listed_in": true,
                    "introduced_in": true
                  },
                  "required": [
                    "sensitive_in",
                    "listed_in",
                    "introduced_in"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ]
}
