{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenPhenology county-weekly/1",
  "description": "A species' weekly result for a county.",
  "type": "object",
  "required": [
    "id",
    "kind",
    "format",
    "provenance",
    "data"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "county-weekly"
    },
    "format": {
      "type": "string",
      "pattern": "^county-weekly/1\\.\\d+$"
    },
    "provenance": {
      "type": "object",
      "required": [
        "release",
        "sources",
        "licences",
        "gbif_download_dois",
        "method",
        "taxonomy",
        "boundaries",
        "ranges",
        "protection",
        "code",
        "run"
      ],
      "properties": {
        "release": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "licences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gbif_download_dois": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "taxonomy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "boundaries": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ranges": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "protection": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "run": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "data": {
      "type": "object",
      "required": [
        "area",
        "species_key",
        "included_records",
        "contributing_years",
        "thresholds",
        "weekly",
        "season",
        "season_withheld",
        "effort",
        "limits"
      ],
      "properties": {
        "area": {
          "type": "string",
          "pattern": "^\\d{5}$"
        },
        "species_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "included_records": {
          "type": "integer",
          "minimum": 0
        },
        "contributing_years": {
          "type": "integer",
          "minimum": 0
        },
        "thresholds": {
          "type": "object",
          "required": [
            "records",
            "years"
          ],
          "properties": {
            "records": {
              "type": "integer",
              "minimum": 0
            },
            "years": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "weekly": {
          "type": "object",
          "required": [
            "records",
            "years"
          ],
          "properties": {
            "records": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "minItems": 53,
              "maxItems": 53
            },
            "years": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "minItems": 53,
              "maxItems": 53
            }
          }
        },
        "season": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 53
          },
          "maxItems": 3
        },
        "season_withheld": {
          "anyOf": [
            {
              "enum": [
                "year-round",
                "two-seasons",
                "one-year",
                "precision"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "effort": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 53,
          "maxItems": 53
        },
        "limits": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "season": {
                  "type": "array",
                  "minItems": 3
                },
                "season_withheld": {
                  "type": "null"
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "season": {
                  "type": "array",
                  "maxItems": 0
                },
                "season_withheld": {
                  "enum": [
                    "year-round",
                    "two-seasons",
                    "one-year",
                    "precision"
                  ]
                }
              }
            }
          ]
        }
      ]
    }
  }
}
