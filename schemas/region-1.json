{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenPhenology region/1",
  "description": "A state, its counties, their species and effort.",
  "type": "object",
  "required": [
    "id",
    "kind",
    "format",
    "provenance",
    "data"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "region"
    },
    "format": {
      "type": "string",
      "pattern": "^region/1\\.\\d+$"
    },
    "provenance": {
      "type": "object",
      "required": [
        "release",
        "sources",
        "licences",
        "gbif_download_dois",
        "method",
        "taxonomy",
        "boundaries",
        "ranges",
        "protection",
        "code",
        "run"
      ],
      "properties": {
        "release": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "licences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gbif_download_dois": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "taxonomy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "boundaries": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ranges": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "protection": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "run": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "data": {
      "type": "object",
      "required": [
        "state",
        "name",
        "slug",
        "areas"
      ],
      "properties": {
        "state": {
          "type": "string",
          "pattern": "^[a-z]{2}-[a-z0-9]{1,3}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "areas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "area",
              "level",
              "name",
              "slug",
              "species_keys",
              "range_species_keys",
              "effort"
            ],
            "properties": {
              "area": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z]{2}-[a-z0-9]{1,3}$"
                  },
                  {
                    "type": "string",
                    "pattern": "^\\d{5}$"
                  }
                ]
              },
              "level": {
                "enum": [
                  "state",
                  "county"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "slug": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "species_keys": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._-]+$"
                }
              },
              "range_species_keys": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._-]+$"
                }
              },
              "effort": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 53,
                "maxItems": 53
              }
            },
            "allOf": [
              {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "level": {
                        "const": "state"
                      },
                      "area": {
                        "type": "string",
                        "pattern": "^[a-z]{2}-[a-z0-9]{1,3}$"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "level": {
                        "const": "county"
                      },
                      "area": {
                        "type": "string",
                        "pattern": "^\\d{5}$"
                      }
                    }
                  }
                ]
              }
            ]
          }
        }
      }
    }
  }
}
