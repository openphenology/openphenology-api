{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenPhenology region/1",
  "description": "A state, its counties, their species and effort.",
  "type": "object",
  "required": [
    "id",
    "kind",
    "format",
    "provenance",
    "data"
  ],
  "properties": {
    "id": {
      "description": "The file's path from the API root.",
      "type": "string",
      "pattern": "^releases/\\d{4}-\\d{2}-\\d{2}/regions/[a-z]{2}-[a-z0-9]{1,3}(/\\d+)?\\.json$"
    },
    "kind": {
      "description": "The format's name, such as `county-weekly`.",
      "const": "region"
    },
    "format": {
      "description": "Format name and version, for example `county-weekly/1.0`.",
      "type": "string",
      "pattern": "^region/1\\.\\d+$"
    },
    "provenance": {
      "description": "Where the content came from.",
      "type": "object",
      "required": [
        "release",
        "sources",
        "licences",
        "gbif_download_dois",
        "method",
        "taxonomy",
        "boundaries",
        "ranges",
        "protection",
        "code",
        "run"
      ],
      "properties": {
        "release": {
          "description": "The release the file belongs to, such as `2026-10-19`.",
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "sources": {
          "description": "Source IDs, as listed in `sources.json`.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "licences": {
          "description": "The licences of those sources.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gbif_download_dois": {
          "description": "The GBIF downloads the records came from, as DOIs.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "method": {
          "description": "The method version, such as `seasonal-3`.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "taxonomy": {
          "description": "The taxonomy version species keys come from.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "boundaries": {
          "description": "The boundary version areas come from.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ranges": {
          "description": "Each mapped range edition used.",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "protection": {
          "description": "The version of each sensitive-species list applied, by list.",
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "description": "The commit of the code that produced the file.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "run": {
          "description": "The run that produced the file.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "data": {
      "description": "The content, as the format sets out.",
      "type": "object",
      "required": [
        "state",
        "name",
        "slug",
        "areas"
      ],
      "properties": {
        "state": {
          "description": "The state code.",
          "type": "string",
          "pattern": "^[a-z]{2}-[a-z0-9]{1,3}$"
        },
        "name": {
          "description": "The state's name.",
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "description": "The state's page slug.",
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "areas": {
          "description": "The state, then each of its counties.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "area",
              "level",
              "name",
              "slug",
              "species_keys",
              "range_species_keys",
              "effort"
            ],
            "properties": {
              "area": {
                "description": "The area code.",
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z]{2}-[a-z0-9]{1,3}$"
                  },
                  {
                    "type": "string",
                    "pattern": "^\\d{5}$"
                  }
                ]
              },
              "level": {
                "description": "Whether it is a state or a county.",
                "enum": [
                  "state",
                  "county"
                ]
              },
              "name": {
                "description": "Its name, such as `Franklin`.",
                "type": "string",
                "minLength": 1
              },
              "slug": {
                "description": "Its page slug.",
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "species_keys": {
                "description": "Species with a result there.",
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._-]+$"
                }
              },
              "range_species_keys": {
                "description": "Species whose mapped range covers it.",
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._-]+$"
                }
              },
              "effort": {
                "description": "Records of all species counted in the area, weeks 1 to 53.",
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 53,
                "maxItems": 53
              }
            },
            "allOf": [
              {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "level": {
                        "const": "state"
                      },
                      "area": {
                        "type": "string",
                        "pattern": "^[a-z]{2}-[a-z0-9]{1,3}$"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "level": {
                        "const": "county"
                      },
                      "area": {
                        "type": "string",
                        "pattern": "^\\d{5}$"
                      }
                    }
                  }
                ]
              }
            ]
          }
        }
      }
    }
  }
}
