{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenPhenology place-labels/1",
  "description": "A place's label for each species with a result there and each week. May be split into shards.",
  "type": "object",
  "required": [
    "id",
    "kind",
    "format",
    "provenance",
    "data"
  ],
  "properties": {
    "id": {
      "description": "The file's path from the API root.",
      "type": "string",
      "pattern": "^releases/\\d{4}-\\d{2}-\\d{2}/labels/(huc8-\\d{8}|eco-\\d+|parks?-[a-z0-9]+(-[a-z0-9]+)*)(/\\d+)?\\.json$"
    },
    "kind": {
      "description": "The format's name, such as `county-weekly`.",
      "const": "place-labels"
    },
    "format": {
      "description": "Format name and version, for example `county-weekly/1.0`.",
      "type": "string",
      "pattern": "^place-labels/1\\.\\d+$"
    },
    "provenance": {
      "description": "Where the content came from.",
      "type": "object",
      "required": [
        "release",
        "sources",
        "licences",
        "gbif_download_dois",
        "method",
        "taxonomy",
        "boundaries",
        "ranges",
        "protection",
        "code",
        "run"
      ],
      "properties": {
        "release": {
          "description": "The release the file belongs to, such as `2026-10-19`.",
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "sources": {
          "description": "Source IDs, as listed in `sources.json`.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "licences": {
          "description": "The licences of those sources.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gbif_download_dois": {
          "description": "The GBIF downloads the records came from, as DOIs.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "method": {
          "description": "The method version, such as `seasonal-3`.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "taxonomy": {
          "description": "The taxonomy version species keys come from.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "boundaries": {
          "description": "The boundary version areas come from.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ranges": {
          "description": "Each mapped range edition used.",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "protection": {
          "description": "The version of each sensitive-species list applied, by list.",
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "description": "The commit of the code that produced the file.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "run": {
          "description": "The run that produced the file.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "data": {
      "description": "The content, as the format sets out.",
      "type": "object",
      "required": [
        "area",
        "method",
        "evidence_through",
        "effort",
        "species"
      ],
      "properties": {
        "area": {
          "description": "The place's area code.",
          "type": "string",
          "pattern": "^(huc8-\\d{8}|eco-\\d+|parks?-[a-z0-9]+(-[a-z0-9]+)*)$"
        },
        "method": {
          "description": "The method version.",
          "type": "string",
          "minLength": 1
        },
        "evidence_through": {
          "description": "The latest record date counted, `YYYY-MM-DD`.",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "effort": {
          "description": "Records of all species counted in the place, weeks 1 to 53.",
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 53,
          "maxItems": 53
        },
        "species": {
          "description": "Each species with a result there.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "species_key",
              "group",
              "labels",
              "records",
              "weekly",
              "season",
              "season_withheld"
            ],
            "properties": {
              "species_key": {
                "description": "The species key.",
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+$"
              },
              "group": {
                "description": "The browse group.",
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z]+(-[a-z]+)*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "labels": {
                "description": "53 letters, one per week: `c`, `s` or `r`.",
                "type": "string",
                "pattern": "^[csr]{53}$"
              },
              "records": {
                "description": "The place result's records counted.",
                "type": "integer",
                "minimum": 0
              },
              "weekly": {
                "description": "The place result's weekly records, weeks 1 to 53.",
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 53,
                "maxItems": 53
              },
              "season": {
                "description": "The place result's season weeks, or empty.",
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 53
                },
                "maxItems": 3
              },
              "season_withheld": {
                "description": "Why the place result's season is withheld, or `null`.",
                "anyOf": [
                  {
                    "enum": [
                      "year-round",
                      "two-seasons",
                      "one-year",
                      "precision"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "allOf": [
              {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "season": {
                        "type": "array",
                        "minItems": 3
                      },
                      "season_withheld": {
                        "type": "null"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "season": {
                        "type": "array",
                        "maxItems": 0
                      },
                      "season_withheld": {
                        "enum": [
                          "year-round",
                          "two-seasons",
                          "one-year",
                          "precision"
                        ]
                      }
                    }
                  }
                ]
              }
            ]
          }
        }
      }
    }
  }
}
