{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenPhenology backyard/1",
  "description": "A county's Backyard label for each species and week.",
  "type": "object",
  "required": [
    "id",
    "kind",
    "format",
    "provenance",
    "data"
  ],
  "properties": {
    "id": {
      "description": "The file's path from the API root.",
      "type": "string",
      "pattern": "^releases/\\d{4}-\\d{2}-\\d{2}/backyard/[a-z]{2}-[a-z0-9]{1,3}/\\d{5}(/\\d+)?\\.json$"
    },
    "kind": {
      "description": "The format's name, such as `county-weekly`.",
      "const": "backyard"
    },
    "format": {
      "description": "Format name and version, for example `county-weekly/1.0`.",
      "type": "string",
      "pattern": "^backyard/1\\.\\d+$"
    },
    "provenance": {
      "description": "Where the content came from.",
      "type": "object",
      "required": [
        "release",
        "sources",
        "licences",
        "gbif_download_dois",
        "method",
        "taxonomy",
        "boundaries",
        "ranges",
        "protection",
        "code",
        "run"
      ],
      "properties": {
        "release": {
          "description": "The release the file belongs to, such as `2026-10-19`.",
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "sources": {
          "description": "Source IDs, as listed in `sources.json`.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "licences": {
          "description": "The licences of those sources.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gbif_download_dois": {
          "description": "The GBIF downloads the records came from, as DOIs.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "method": {
          "description": "The method version, such as `seasonal-3`.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "taxonomy": {
          "description": "The taxonomy version species keys come from.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "boundaries": {
          "description": "The boundary version areas come from.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ranges": {
          "description": "Each mapped range edition used.",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "protection": {
          "description": "The version of each sensitive-species list applied, by list.",
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "description": "The commit of the code that produced the file.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "run": {
          "description": "The run that produced the file.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "data": {
      "description": "The content, as the format sets out.",
      "type": "object",
      "required": [
        "area",
        "method",
        "evidence_through",
        "effort",
        "species"
      ],
      "properties": {
        "area": {
          "description": "The county's 5-digit Census code.",
          "type": "string",
          "pattern": "^\\d{5}$"
        },
        "method": {
          "description": "The method version.",
          "type": "string",
          "minLength": 1
        },
        "evidence_through": {
          "description": "The latest record date counted, `YYYY-MM-DD`.",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "effort": {
          "description": "Records of all species counted in the county, weeks 1 to 53.",
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 53,
          "maxItems": 53
        },
        "species": {
          "description": "Each species with a result or a mapped range covering the county.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "species_key",
              "group",
              "labels",
              "range"
            ],
            "properties": {
              "species_key": {
                "description": "The species key.",
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+$"
              },
              "group": {
                "description": "The browse group.",
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z]+(-[a-z]+)*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "labels": {
                "description": "53 letters, one per week.",
                "type": "string",
                "pattern": "^[csrmn]{53}$"
              },
              "range": {
                "description": "The mapped range covering the county, or `null`.",
                "anyOf": [
                  {
                    "type": "object",
                    "required": [
                      "source",
                      "seasons"
                    ],
                    "properties": {
                      "source": {
                        "description": "The range's source ID.",
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "seasons": {
                        "description": "The range's seasons there.",
                        "type": "array",
                        "items": {
                          "enum": [
                            "year-round",
                            "summer",
                            "winter",
                            "migratory",
                            "passage"
                          ]
                        }
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}
