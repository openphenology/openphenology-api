{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenPhenology backyard/1",
  "description": "A county's Backyard label for each species and week.",
  "type": "object",
  "required": [
    "id",
    "kind",
    "format",
    "provenance",
    "data"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "backyard"
    },
    "format": {
      "type": "string",
      "pattern": "^backyard/1\\.\\d+$"
    },
    "provenance": {
      "type": "object",
      "required": [
        "release",
        "sources",
        "licences",
        "gbif_download_dois",
        "method",
        "taxonomy",
        "boundaries",
        "ranges",
        "protection",
        "code",
        "run"
      ],
      "properties": {
        "release": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "licences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gbif_download_dois": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "taxonomy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "boundaries": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ranges": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "protection": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "run": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "data": {
      "type": "object",
      "required": [
        "area",
        "method",
        "evidence_through",
        "effort",
        "species"
      ],
      "properties": {
        "area": {
          "type": "string",
          "pattern": "^\\d{5}$"
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "evidence_through": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "effort": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 53,
          "maxItems": 53
        },
        "species": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "species_key",
              "group",
              "labels",
              "range"
            ],
            "properties": {
              "species_key": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+$"
              },
              "group": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z]+(-[a-z]+)*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "labels": {
                "type": "string",
                "pattern": "^[csrmn]{53}$"
              },
              "range": {
                "anyOf": [
                  {
                    "type": "object",
                    "required": [
                      "source",
                      "seasons"
                    ],
                    "properties": {
                      "source": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "seasons": {
                        "type": "array",
                        "items": {
                          "enum": [
                            "year-round",
                            "summer",
                            "winter",
                            "migratory",
                            "passage"
                          ]
                        }
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}
