{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenPhenology attribution/1",
  "description": "The sources behind a result.",
  "type": "object",
  "required": [
    "id",
    "kind",
    "format",
    "provenance",
    "data"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "attribution"
    },
    "format": {
      "type": "string",
      "pattern": "^attribution/1\\.\\d+$"
    },
    "provenance": {
      "type": "object",
      "required": [
        "release",
        "sources",
        "licences",
        "gbif_download_dois",
        "method",
        "taxonomy",
        "boundaries",
        "ranges",
        "protection",
        "code",
        "run"
      ],
      "properties": {
        "release": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "licences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gbif_download_dois": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "taxonomy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "boundaries": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ranges": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "protection": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "run": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "data": {
      "type": "object",
      "required": [
        "area",
        "species_key",
        "datasets",
        "gbif_download_dois",
        "record_links"
      ],
      "properties": {
        "area": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z]{2}-[a-z0-9]{1,3}$"
            },
            {
              "type": "string",
              "pattern": "^\\d{5}$"
            }
          ]
        },
        "species_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "datasets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "dataset_key",
              "title",
              "publisher",
              "citation",
              "url",
              "records"
            ],
            "properties": {
              "dataset_key": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "publisher": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "citation": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "url": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "records": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "gbif_download_dois": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "record_links": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
