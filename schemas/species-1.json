{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenPhenology species/1",
  "description": "One species and every area with a result or within its mapped range.",
  "type": "object",
  "required": [
    "id",
    "kind",
    "format",
    "provenance",
    "data"
  ],
  "properties": {
    "id": {
      "description": "The file's path from the API root.",
      "type": "string",
      "pattern": "^releases/\\d{4}-\\d{2}-\\d{2}/species/[A-Za-z0-9._-]+(/\\d+)?\\.json$"
    },
    "kind": {
      "description": "The format's name, such as `county-weekly`.",
      "const": "species"
    },
    "format": {
      "description": "Format name and version, for example `county-weekly/1.0`.",
      "type": "string",
      "pattern": "^species/1\\.\\d+$"
    },
    "provenance": {
      "description": "Where the content came from.",
      "type": "object",
      "required": [
        "release",
        "sources",
        "licences",
        "gbif_download_dois",
        "method",
        "taxonomy",
        "boundaries",
        "ranges",
        "protection",
        "code",
        "run"
      ],
      "properties": {
        "release": {
          "description": "The release the file belongs to, such as `2026-10-19`.",
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "sources": {
          "description": "Source IDs, as listed in `sources.json`.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "licences": {
          "description": "The licences of those sources.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gbif_download_dois": {
          "description": "The GBIF downloads the records came from, as DOIs.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "method": {
          "description": "The method version, such as `seasonal-3`.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "taxonomy": {
          "description": "The taxonomy version species keys come from.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "boundaries": {
          "description": "The boundary version areas come from.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ranges": {
          "description": "Each mapped range edition used.",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "protection": {
          "description": "The version of each sensitive-species list applied, by list.",
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "description": "The commit of the code that produced the file.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "run": {
          "description": "The run that produced the file.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "data": {
      "description": "The content, as the format sets out.",
      "type": "object",
      "required": [
        "species_key",
        "scientific_name",
        "authorship",
        "common_name",
        "synonyms",
        "rank",
        "classification",
        "group",
        "slug",
        "areas",
        "ranges"
      ],
      "properties": {
        "species_key": {
          "description": "The species key in the shared taxonomy.",
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "scientific_name": {
          "description": "The scientific name, without authorship.",
          "type": "string",
          "minLength": 1
        },
        "authorship": {
          "description": "The authorship of the scientific name.",
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "common_name": {
          "description": "The display name, or `null` when there is none.",
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "synonyms": {
          "description": "Other scientific names, from the shared taxonomy.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rank": {
          "description": "The taxonomic rank, such as `species`.",
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "description": "Kingdom to genus.",
          "type": "object",
          "required": [
            "kingdom",
            "phylum",
            "class",
            "order",
            "family",
            "genus"
          ],
          "properties": {
            "kingdom": {
              "description": "The kingdom.",
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "phylum": {
              "description": "The phylum.",
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "class": {
              "description": "The class.",
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "order": {
              "description": "The order.",
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "family": {
              "description": "The family.",
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "genus": {
              "description": "The genus.",
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "group": {
          "description": "The browse group, such as `birds`.",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z]+(-[a-z]+)*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "slug": {
          "description": "The page slug.",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "areas": {
          "description": "Every area with a result.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "area",
              "level",
              "records",
              "season",
              "season_withheld"
            ],
            "properties": {
              "area": {
                "description": "The area code.",
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z]{2}-[a-z0-9]{1,3}$"
                  },
                  {
                    "type": "string",
                    "pattern": "^\\d{5}$"
                  }
                ]
              },
              "level": {
                "description": "Whether it is a state or a county.",
                "enum": [
                  "state",
                  "county"
                ]
              },
              "records": {
                "description": "Records counted there.",
                "type": "integer",
                "minimum": 0
              },
              "season": {
                "description": "Early, middle and late weeks, or empty.",
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 53
                },
                "maxItems": 3
              },
              "season_withheld": {
                "description": "Why `season` is empty, or `null`.",
                "anyOf": [
                  {
                    "enum": [
                      "year-round",
                      "two-seasons",
                      "one-year",
                      "precision"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "allOf": [
              {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "level": {
                        "const": "state"
                      },
                      "area": {
                        "type": "string",
                        "pattern": "^[a-z]{2}-[a-z0-9]{1,3}$"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "level": {
                        "const": "county"
                      },
                      "area": {
                        "type": "string",
                        "pattern": "^\\d{5}$"
                      }
                    }
                  }
                ]
              },
              {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "season": {
                        "type": "array",
                        "minItems": 3
                      },
                      "season_withheld": {
                        "type": "null"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "season": {
                        "type": "array",
                        "maxItems": 0
                      },
                      "season_withheld": {
                        "enum": [
                          "year-round",
                          "two-seasons",
                          "one-year",
                          "precision"
                        ]
                      }
                    }
                  }
                ]
              }
            ]
          }
        },
        "ranges": {
          "description": "Every area within its mapped range.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "area",
              "level",
              "source",
              "seasons"
            ],
            "properties": {
              "area": {
                "description": "The area code.",
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z]{2}-[a-z0-9]{1,3}$"
                  },
                  {
                    "type": "string",
                    "pattern": "^\\d{5}$"
                  }
                ]
              },
              "level": {
                "description": "Whether it is a state or a county.",
                "enum": [
                  "state",
                  "county"
                ]
              },
              "source": {
                "description": "The range's source ID.",
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "seasons": {
                "description": "The range's seasons there.",
                "type": "array",
                "items": {
                  "enum": [
                    "year-round",
                    "summer",
                    "winter",
                    "migratory",
                    "passage"
                  ]
                }
              }
            },
            "allOf": [
              {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "level": {
                        "const": "state"
                      },
                      "area": {
                        "type": "string",
                        "pattern": "^[a-z]{2}-[a-z0-9]{1,3}$"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "level": {
                        "const": "county"
                      },
                      "area": {
                        "type": "string",
                        "pattern": "^\\d{5}$"
                      }
                    }
                  }
                ]
              }
            ]
          }
        },
        "statuses": {
          "description": "The species' listings on government lists: the federal Endangered\nSpecies Act list and Ohio's lists. Empty when it is on none. Added in\n`species/1.1`, so absent from `species/1.0` files.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "list",
              "place",
              "listed_name",
              "status",
              "where"
            ],
            "properties": {
              "list": {
                "description": "The list: `usfws` (US Fish & Wildlife Service, Endangered Species Act) or `ohio`.",
                "enum": [
                  "usfws",
                  "ohio"
                ]
              },
              "place": {
                "description": "Where the list applies: `us` for the federal list, a state code for a state list.",
                "type": "string",
                "pattern": "^(us|[a-z]{2}-[a-z0-9]{1,3})$"
              },
              "listed_name": {
                "description": "The scientific name the list gives; it shows when only a subspecies or variety is listed.",
                "type": "string",
                "minLength": 1
              },
              "status": {
                "description": "The status, as the list writes it, such as `Endangered`.",
                "type": "string",
                "minLength": 1
              },
              "where": {
                "description": "The federal list's own description of where the listing applies, such as `Wherever found`; `null` for a state list.",
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "format": {
            "enum": [
              "species/1.0"
            ]
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "statuses": true
            },
            "required": [
              "statuses"
            ]
          }
        }
      }
    }
  ]
}
