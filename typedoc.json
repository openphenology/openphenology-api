{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts"],
  "tsconfig": "tsconfig.build.json",
  "name": "@openphenology/api",
  "readme": "README.md",
  "excludeInternal": true,
  "excludePrivate": true,
  "includeVersion": true,
  "treatWarningsAsErrors": true,
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": true
  },
  "outputs": [
    {
      "name": "html",
      "path": "./docs"
    },
    {
      "name": "json",
      "path": "./docs/api.json"
    }
  ]
}
