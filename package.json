{
  "name": "@openphenology/api",
  "version": "0.1.0",
  "description": "Read OpenPhenology data",
  "keywords": [
    "openphenology",
    "phenology",
    "biodiversity",
    "species",
    "gbif"
  ],
  "homepage": "https://github.com/openphenology/openphenology-api#readme",
  "bugs": "https://github.com/openphenology/openphenology-api/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openphenology/openphenology-api.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "default": "./dist/format.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "dist",
    "schemas/*.json",
    "schemas/examples/*.json",
    "llms.txt"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "tsc -p tsconfig.build.json --removeComments && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "prepare": "tsc -p tsconfig.build.json --removeComments && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src",
    "test": "pnpm test:node && vitest run --project 'browser*'",
    "test:node": "vitest run --project node --coverage",
    "docs:build": "typedoc",
    "docs:check": "typedoc --emit none && node scripts/llms.ts && node scripts/readme.ts",
    "schemas": "node scripts/schemas.ts",
    "schemas:check": "node scripts/schemas.ts --check",
    "check": "pnpm check:node && vitest run --project 'browser*'",
    "check:node": "pnpm format:check && pnpm schemas:check && pnpm lint && pnpm typecheck && pnpm docs:check && pnpm test:node && pnpm build && pnpm size",
    "size": "node scripts/size.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "ajv": "8.20.0",
    "eslint": "10.12.0",
    "eslint-plugin-jsdoc": "65.1.0",
    "playwright": "1.64.0",
    "prettier": "3.9.10",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 iOS versions"
  ]
}
